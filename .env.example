# RK Solar — copy to .env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — used for auth redirects + referral link copy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Facebook Lead Ads (Phase 4)
FACEBOOK_VERIFY_TOKEN=your-meta-verify-token
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token
FACEBOOK_DEFAULT_COMPANY_ID=a0000000-0000-4000-8000-000000000001

# Cron (Module 7 polish) — Authorization: Bearer <secret> on /api/cron/reminders
CRON_SECRET=change-me-long-random

# Evening daily report (Phase 2) — /api/cron/daily-report ~19:00 IST (vercel.json)
# Comma-separated recipients; also optional companies.daily_report_emails column
DAILY_REPORT_TO=ops@example.com
# Optional Resend delivery (without key, cron logs HTML and marks run as "logged")
# RESEND_API_KEY=re_xxx
# DAILY_REPORT_FROM=RK Reports <reports@yourdomain.com>

# Optional WhatsApp provider webhook — POST { to, eventType, leadId, payload }
# If unset, outbox rows are still marked sent (stub).
# WHATSAPP_WEBHOOK_URL=https://your-provider.example/send
